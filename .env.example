# Copy to .env and fill in. .env is gitignored.

# --- Discord ---
DISCORD_TOKEN=paste-bot-token
APP_ID=paste-application-id
GUILD_ID=paste-guild-id

# --- Storage ---
DB_PATH=crewguard.db

# --- Classifier (per-message moderation; must be fast) ---
# Ordered, comma-separated. First healthy backend wins.
# Localhost is the usual case: Ollama on the same machine as the bot.
# Add more backends (a faster GPU box first) and they are preferred in order.
CLASSIFIER_BACKENDS=http://127.0.0.1:11434
CLASSIFIER_MODEL=qwen3:8b

# --- Leadership guidance (GM / Server Admin management chat; rare, can be slower) ---
# Larger model. Pull it before use: `ollama pull qwen3-coder:30b`.
LEADERSHIP_MODEL=qwen3-coder:30b
LEADERSHIP_BACKENDS=http://127.0.0.1:11434

# --- Feature flags ---
# Crew-facing Q&A (DM answers, @mention, interjection). OFF for launch — the feature lives on
# branch feature/crew-assistant. Leadership guidance and the join greeting are unaffected.
CREW_QA_ENABLED=false

# --- Watcher (backstop re-scan of existing messages) ---
# Periodically re-scans recent channel history and removes anything that now violates the rules
# (edits into hostility, or messages let through while the classifier was down). ON by default.
# Longer interval = less load on the classifier backend.
WATCHER_ENABLED=true
WATCH_INTERVAL_MINUTES=30

# --- Retention ---
# Stored message content (removals, leadership notes) is auto-deleted after this many days.
RETENTION_DAYS=30
